datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}
// ─── better-auth required tables ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("admin")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                   String    @id @default(cuid())
  userId               String
  accountId            String
  providerId           String
  accessToken          String?
  refreshToken         String?
  idToken              String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope                String?
  password             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Home ────────────────────────────────────────────────────────────────────

model HomeVideo {
  id         String   @id @default(cuid())
  videoLabel String?
  videoUrl   String   // Cloudinary URL
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AboutUsHome {
  id        String   @id @default(cuid())
  content   Json     // Tiptap JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomeGallery {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  imageUrl   String
  isFeatured Boolean  @default(false) // true = the large left panel
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Service Carousel ────────────────────────────────────────────────────────

/// Homepage "What We Do" services section (formerly a slider; table name kept)
model ServiceCarousel {
  id           String   @id @default(cuid())
  title        String
  description  String
  serviceLink  String
  requestLink  String
  mainImageUrl String
  category     String   // ICI-roofing | architectural-cladding | residential-roofing | repairs | waterproofing | restoration
  points       String[] @default([]) // bullet list shown under the description on the homepage
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Projects ────────────────────────────────────────────────────────────────

/// Portfolio thumbnail shown on /projects listing page
model ProjectPage {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  imageUrl  String
  category  String[]
  sector    String?  // "ICI" | "Residential" — shown as the card badge
  service   String?  // one of the five service labels — the filter axis
  systems   String[] // any of "TPO" | "SBS" | "EPDM" | "ACM" | "Standing Seam" | "Hot Rubber"
  year      Int?     // completion year, shown in card meta
  city      String?
  latitude  Float?
  longitude Float?
  order     Int      @default(0)
  published Boolean  @default(false) // drafts are hidden from the public site
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Full project detail page
model Project {
  id                String      @id @default(cuid())
  title             String
  slug              String      @unique
  blurb             String?     // hero sub-paragraph
  area              String?     // e.g. "48,000 sq ft" — shown in the glance line
  scope             String?     // Scope paragraph
  challenge         String?     // "The challenge" column
  solution          String?     // "What we did" column
  droneImageUrl     String?     // drone block still / poster frame
  droneVideoId      String?     // YouTube id for the drone walkthrough
  droneDuration     String?     // e.g. "2:14"
  backgroundVideoUrl String?
  fallbackImageUrl  String?
  content           String?
  mainImageUrl      String?
  listSections      Json?       // assemblies: [{ title: string, items: string[] }]
  extraContent      String?
  extraImageUrl     String?
  fullWidthImageUrl String?
  centeredText      String?
  images            String[]    // gallery — Cloudinary URLs
  carouselImages    String[]    // sequence — 5 Cloudinary URLs, one per stage
  firstEmbed        String?     // YouTube video ID
  secondEmbed       String?
  thirdEmbed        String?

  // Flexible project page (see components/sections/ProjectDetailView.tsx)
  subtitle          String?     // hero line under the title
  overview          String[]    @default([]) // Overview paragraphs after the lead (blurb)
  underConstruction Boolean     @default(false)
  facts             Json?       // [{ label, value }]
  highlight         Json?       // { label?, title, body?, imageUrl? }
  chapters          Json?       // [{ title, body: string[], items?: string[], imageUrl? }]
  video             Json?       // { id, title?, body?, vertical? }
  sequenceCaptions  String[]    @default([])
  overviewImages    Json?       // { [slotId]: imageUrl | "none" }, see src/lib/overview-layout.ts
  photos            String[]    @default([]) // this project's photo library, in upload order
  skipPhotos        String[]    @default([]) // library photos never placed automatically

  projectPage       ProjectPage?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

// ─── Service Pages ────────────────────────────────────────────────────────────

model Repairs {
  id            String   @id @default(cuid())
  title         String
  firstContent  String?
  secondContent String?
  firstImageUrl String?
  firstImageAlt String?
  thirdContent  String?
  images        Json?    // [{ url: string, alt: string }]
  listSections  Json?    // [{ items: string[] }]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Waterproofing {
  id                  String   @id @default(cuid())
  title               String
  description         String?
  accordionItems      Json?    // [{ accordionTitle: string, accordionContent: string }]
  gallery             Json?    // [{ url: string, galleryAlt: string }]
  manufacturersGallery Json?   // [{ url: string, manufacturerAlt: string }]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ICIRoofing {
  id              String   @id @default(cuid())
  title           String
  content         String?
  firstTitle      String?
  firstContent    String?
  firstImageUrl   String?
  firstImageAlt   String?
  secondImageUrl  String?
  secondImageAlt  String?
  secondContent   String?
  thirdContent    String?
  secondTitle     String?
  listSections    Json?    // [{ items: string[] }]
  listItem        String?
  galleryImages   Json?    // [{ url: string, alt: string }]
  extraTitle      String?
  carouselMImages Json?    // [{ url: string, alt: string }]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Cladding {
  id              String   @id @default(cuid())
  title           String
  content         String?
  listSections    Json?    // [{ items: string[] }]
  galleryImages   Json?    // [{ url: string, alt: string }]
  extraTitle      String?
  extraContent    String?
  carouselMImages Json?    // [{ url: string, alt: string }]
  carouselADImages Json?   // [{ url: string, alt: string }]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Restoration {
  id           String   @id @default(cuid())
  title        String
  introText    String?
  heroImageUrl String?
  heroImageAlt String?
  galleryImages Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Residential {
  id                   String   @id @default(cuid())
  title                String
  backgroundImageUrl   String?
  backgroundImageAlt   String?
  residentialList      Json?    // [{ items: string[] }]
  firstTitle           String?
  firstContent         String?
  firstImageUrl        String?
  firstImageAlt        String?
  secondImageUrl       String?
  secondImageAlt       String?
  residentialImages    String[]
  asphaltTitle         String?
  asphaltFirstContent  String?
  asphaltImageUrl      String?
  asphaltImageAlt      String?
  asphaltImages        String[]
  cedarTitle           String?
  cedarFirstContent    String?
  cedarFirstImageUrl   String?
  cedarFirstImageAlt   String?
  cedarSecondImageUrl  String?
  cedarSecondImageAlt  String?
  cedarImages          String[]
  metalsTitle          String?
  metalsList           Json?    // [{ items: string[] }]
  metalsContent        String?
  metalsFirstImageUrl  String?
  metalsFirstImageAlt  String?
  metalsImages         String[]
  guttersTitle         String?
  guttersContent       String?
  guttersFirstImageUrl  String?
  guttersFirstImageAlt  String?
  guttersSecondImageUrl String?
  guttersSecondImageAlt String?
  guttersImages        String[]
  naturalTitle         String?
  naturalContent       String?
  naturalImages        String[]
  syntheticTitle       String?
  syntheticContent     String?
  syntheticImageUrl    String?
  syntheticImageAlt    String?
  syntheticImages      String[]
  skylightTitle        String?
  skylightContent      String?
  carouselMImages      Json?    // [{ url: string, alt: string }]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ─── Testimonials ─────────────────────────────────────────────────────────────

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  name      String
  imgUrl    String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Careers ──────────────────────────────────────────────────────────────────

model Career {
  id        String   @id @default(cuid())
  title     String
  location  String
  jobType   String   // "Full Time" | "Part Time" | "Contract" etc.
  applyUrl  String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── News & Charity ───────────────────────────────────────────────────────────

/// Blog / news posts — /news and the homepage "Recent Posts" grid
model Post {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  category      String    // Project Update | Community | Roofing Tips | Company News
  excerpt       String    // short summary for cards and SEO description
  content       Json?     // Tiptap JSON
  coverImageUrl String?
  coverImageAlt String?
  published     Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([published, publishedAt])
}

/// Homepage charity spotlight (single row)
model CharitySpotlight {
  id           String   @id @default(cuid())
  enabled      Boolean  @default(true)
  label        String   @default("Annual Charity Golf Tournament")
  title        String
  body         String
  imageUrl     String?
  imageAlt     String?
  nextEvent    String?  // free text, e.g. "June 12, 2027"
  raisedToDate String?  // free text, e.g. "$48,000"
  venue        String?
  causeTitle   String?
  causeBody    String?
  recapLink    String?
  donateLink   String?
  updatedAt    DateTime @updatedAt
}
